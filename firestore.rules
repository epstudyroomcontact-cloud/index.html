rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = đúng email của chủ trang VÀ email đã được xác minh (không thể mạo danh vì phải mở được hộp thư).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'epstudyroom.contact@gmail.com';
    }
    function signedIn() { return request.auth != null; }
    // Người đồng hành còn hạn: có tài liệu companions/<uid> và (không có ngày hết hạn HOẶC ngày hết hạn YYYY-MM-DD chưa qua; so theo giờ UTC, có ân hạn 1 ngày)
    function compActive(uid) {
      let c = get(/databases/$(database)/documents/companions/$(uid)).data;
      let u = c.get('until', '');
      let d = request.time - duration.value(1, 'd');   // ân hạn 1 ngày: người dùng ở múi giờ phía tây UTC vẫn thấy "còn hạn" trên máy mình đến hết ngày của họ
      return u == null || u == ''
        || (int(u.split('-')[0]) * 10000 + int(u.split('-')[1]) * 100 + int(u.split('-')[2])
            >= d.year() * 10000 + d.month() * 100 + d.day());
    }
    // Cài đặt ưu đãi (admin chỉnh ở tab Thanh toán): bật/tắt, số tháng tặng thêm, số ngày hiệu lực. Mặc định bật, 1 tháng, 30 ngày.
    function moonCfg() { return get(/databases/$(database)/documents/settings/payments).data; }
    function moonRewardOk(d) {
      let c = moonCfg();
      return c.get('moonRewardOn', true) == true
        && d.months == c.get('moonRewardMonths', 1)
        && d.expires is timestamp
        && d.expires > request.time
        && d.expires <= request.time + duration.value(int(c.get('moonRewardDays', 30)) + 1, 'd');
    }
    // Mã dùng thử: khách đã đăng nhập nhập mã → được dùng như Người đồng hành (Planner, Focus không giới hạn) trong số ngày admin đặt cho mã.
    // Quyền dùng thử còn khi: admin đặt hạn riêng (endsAt) còn tương lai, HOẶC mã vẫn tồn tại, đang bật và chưa hết `days` ngày tính từ lúc kích hoạt (startedAt, giờ máy chủ).
    function trialOk(uid) {
      let p = /databases/$(database)/documents/trial_redemptions/$(uid);
      return exists(p) && trialLive(get(p).data);
    }
    function trialLive(r) {
      return r.get('endsAt', null) is timestamp ? r.endsAt > request.time : trialCodeLive(r.code, r.startedAt);
    }
    function trialCodeLive(code, started) {
      let p = /databases/$(database)/documents/trial_codes/$(code);
      return exists(p) && get(p).data.active == true && started + duration.value(get(p).data.days, 'd') > request.time;
    }
    // Kích hoạt mã: mã có thật, đang bật, chưa quá hạn nhập (expiresAt), và lượt dùng của mã được cộng đúng 1 trong cùng lần ghi, không vượt maxUses (0 = không giới hạn).
    function trialRedeemOk(code) {
      let c = get(/databases/$(database)/documents/trial_codes/$(code)).data;
      let n = getAfter(/databases/$(database)/documents/trial_codes/$(code)).data.get('uses', 0);
      return c.active == true
        && (c.get('expiresAt', null) == null || c.expiresAt > request.time)
        && n == c.get('uses', 0) + 1
        && (c.get('maxUses', 0) == 0 || n <= c.maxUses);
    }
    function pushListOk(m, k) { return !(m is map) || !(m.get(k, []) is list) || m.get(k, []).size() <= 50; }
    function moonStreakOk(uid) {
      let m = get(/databases/$(database)/documents/users/$(uid)).data.moon;
      return m.get('best', 0) >= 60 || m.days.size() >= 60;
    }
    // Nhóm học trực tiếp: chỉ admin, Người đồng hành còn hạn hoặc người đang dùng thử (cùng điều kiện với Planner)
    function grpAccess() {
      return signedIn() && (isAdmin()
        || (exists(/databases/$(database)/documents/companions/$(request.auth.uid)) && compActive(request.auth.uid))
        || trialOk(request.auth.uid));
    }
    // live[uid] = { n:tên, s:lúc bắt đầu học (ms), k:'f' tập trung | 'b' nghỉ, b:nhịp báo gần nhất (ms, lệch giờ máy chủ tối đa 10 phút) }
    function grpLiveOk(uid, m, old) {
      return !(uid in m) || (uid in old && m[uid] == old[uid]) || (   // phần không đổi thì không kiểm lại (nếu không, ghi phút tuần sẽ bị từ chối khi nhịp báo cũ quá 10 phút)
        m[uid].keys().hasOnly(['n', 's', 'k', 'b'])
        && m[uid].n is string && m[uid].n.size() >= 1 && m[uid].n.size() <= 20
        && m[uid].s is int && m[uid].b is int
        && m[uid].k in ['f', 'b']
        && m[uid].b > request.time.toMillis() - 600000 && m[uid].b < request.time.toMillis() + 600000
        && m[uid].s <= m[uid].b && m[uid].s > m[uid].b - 172800000);
    }
    // board[uid] = { n:tên, mins:tổng phút tập trung trong tuần, t:giờ máy chủ lần ghi cuối, f:giờ máy chủ lúc mục được tạo, z:số phút lúc đó }
    // Chống khai khống phút: (1) mỗi lần ghi chỉ tăng tối đa 180 phút và không nhanh hơn thời gian thật từ lần ghi trước (+2 phút du di);
    // (2) tính cả tuần: số phút cộng thêm kể từ mốc f (mins - z) không vượt thời gian thật đã trôi qua từ f + 180 phút (phần học dồn lúc mới vào bảng). Mốc f, z chỉ ghi một lần.
    // Mục cũ chưa có f (tạo trước khi có luật này) được gắn mốc ở lần cộng phút kế tiếp. Tối đa 112 giờ/tuần.
    function grpBoardOk(uid, nw, old) {
      return !(uid in nw) || (uid in old && nw[uid] == old[uid]) || (   // phần không đổi thì không kiểm lại (nếu không, ghi trạng thái "đang học" sẽ bị từ chối khi người đó đã có phút trên bảng)
        nw[uid].keys().hasOnly(['n', 'mins', 't', 'f', 'z'])
        && nw[uid].n is string && nw[uid].n.size() >= 1 && nw[uid].n.size() <= 20
        && nw[uid].mins is int && nw[uid].mins >= 0 && nw[uid].mins <= 6720
        && nw[uid].t == request.time
        && ((uid in old)
          ? (nw[uid].mins >= old[uid].mins
             && nw[uid].mins - old[uid].mins <= 180
             && (nw[uid].mins - old[uid].mins) * 60000 <= request.time.toMillis() - old[uid].t.toMillis() + 120000
             && ('f' in old[uid]
                  ? (nw[uid].f == old[uid].f && nw[uid].z == old[uid].z
                     && (nw[uid].mins - nw[uid].z) * 60000 <= request.time.toMillis() - nw[uid].f.toMillis() + 10800000)
                  : (nw[uid].mins == old[uid].mins
                      ? (!('f' in nw[uid]) && !('z' in nw[uid]))
                      : (nw[uid].f == request.time && nw[uid].z == old[uid].mins))))
          : (nw[uid].mins <= 180 && nw[uid].f == request.time && nw[uid].z == 0)));
    }
    function grpWriteOk() {
      let uid = request.auth.uid;
      let nw = request.resource.data;
      let live = nw.get('live', {});
      let board = nw.get('board', {});
      let ol = resource == null ? {} : resource.data.get('live', {});
      let ob = resource == null ? {} : resource.data.get('board', {});
      return nw.keys().hasOnly(['live', 'board'])
        && live.diff(ol).affectedKeys().hasOnly([uid])
        && board.diff(ob).affectedKeys().hasOnly([uid])
        && live.size() <= 400 && board.size() <= 400
        && grpLiveOk(uid, live, ol) && grpBoardOk(uid, board, ob);
    }
    // Giao diện, nội dung chữ/ảnh, thông tin thanh toán hiển thị cho khách, lịch live: ai cũng xem, chỉ admin sửa
    match /settings/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /weekly_schedules/{id} { allow read: if true; allow write: if isAdmin(); }

    // Nhóm học trực tiếp: mỗi tuần (giờ Việt Nam) một tài liệu study_group/<năm>-W<tuần> = { live:{ uid:{...} }, board:{ uid:{...} } }.
    // Chỉ người có quyền (grpAccess) đọc được. Mỗi người chỉ ghi được khoá của chính mình trong live và board; admin xoá được mọi khoá.
    match /study_group/{wk} {
      allow read: if grpAccess();
      allow create, update: if wk.matches('^20[0-9]{2}-W[0-5][0-9]$') && (isAdmin() || (grpAccess() && grpWriteOk()));
      allow delete: if isAdmin();
    }

    // Bài viết: khách chỉ đọc được bài đã xuất bản
    match /posts/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // Sản phẩm đang hiển thị
    match /products/{id} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // File/link tải của sản phẩm số: chỉ admin, hoặc người đã được cấp quyền trong thư viện của họ
    match /products_private/{id} {
      allow read: if isAdmin()
        || (signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/library/$(id)));
      allow write: if isAdmin();
    }

    // Đơn hàng: khách (kể cả chưa đăng nhập) chỉ được TẠO đơn trạng thái pending; chỉ admin sửa
    // Chỉ nhận đúng các ô web tạo ra, độ dài có giới hạn, tiền tệ VND/USD: không chèn được ô lạ hay chữ quá dài vào trang admin.
    // Giá do trình duyệt tính nên vẫn có thể bị sửa: trang admin tự so với giá thật và cảnh báo đỏ trước khi bấm "paid".
    match /orders/{id} {
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.keys().hasOnly(['code', 'uid', 'items', 'subtotal', 'discount', 'coupon', 'total', 'currency', 'buyer', 'method', 'status', 'lang', 'createdAt'])
                    && request.resource.data.code is string && request.resource.data.code.size() < 20
                    && request.resource.data.code == id
                    && request.resource.data.items is list && request.resource.data.items.size() >= 1 && request.resource.data.items.size() <= 50
                    && request.resource.data.currency in ['VND', 'USD']
                    && request.resource.data.total is number && request.resource.data.total >= 0
                    && request.resource.data.get('coupon', '') is string && request.resource.data.get('coupon', '').size() <= 40
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.buyer.keys().hasOnly(['name', 'email', 'address', 'note'])
                    && request.resource.data.buyer.email is string && request.resource.data.buyer.email.size() <= 160
                    && request.resource.data.buyer.get('name', '') is string && request.resource.data.buyer.get('name', '').size() <= 80
                    && request.resource.data.buyer.get('address', '') is string && request.resource.data.buyer.get('address', '').size() <= 400
                    && request.resource.data.buyer.get('note', '') is string && request.resource.data.buyer.get('note', '').size() <= 400
                    && (request.resource.data.uid == null
                        || (signedIn() && request.resource.data.uid == request.auth.uid));
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Mã giảm giá: khách chỉ kiểm tra được từng mã (get), không liệt kê được toàn bộ
    match /coupons/{code} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // Đánh giá: khách đã đăng nhập gửi (chờ duyệt); chỉ hiện công khai khi admin duyệt
    match /reviews/{id} {
      allow read: if resource.data.approved == true || isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'name', 'rating', 'text', 'approved', 'createdAt'])
                    && request.resource.data.approved == false
                    && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 80
                    && request.resource.data.text is string && request.resource.data.text.size() <= 600
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    // Hồ sơ người dùng (việc cần làm, thống kê tập trung) — chỉ chính họ và admin
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Giới hạn số máy nhận thông báo lưu trong hồ sơ (nhắc việc Planner, nhắc giữ chuỗi trăng) để không ai nhồi hàng nghìn mã làm chậm máy gửi.
      allow create, update: if signedIn() && request.auth.uid == uid
        && pushListOk(request.resource.data.get('plPush', {}), 'tokens')
        && pushListOk(request.resource.data.get('plPush', {}), 'pinTokens')
        && pushListOk(request.resource.data.get('mjPush', {}), 'tokens');
      match /library/{pid} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow write: if isAdmin();                            // admin cấp quyền tải khi xác nhận đã thanh toán
      }
    }

    // Người đồng hành (ủng hộ hằng tháng): chỉ admin ghi; người dùng chỉ đọc được tài liệu của chính mình
    match /companions/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Ưu đãi mốc 60 ngày của Hành trình trăng: mỗi tài khoản chỉ tạo được MỘT lần (tài liệu mang id = uid, người dùng không sửa/xoá được nên không dùng lại).
    // Rules kiểm: đúng số tháng tặng và hạn theo cài đặt của admin (settings/payments), ưu đãi đang bật, và hồ sơ của chính họ đã ghi chuỗi >= 60 ngày.
    // Chuỗi do trình duyệt tự ghi nên không thể chống giả mạo tuyệt đối, vì vậy admin vẫn đối chiếu khoản thanh toán thật khi duyệt (ưu đãi chỉ là tháng tặng thêm và do admin cộng khi duyệt, không tự mở quyền).
    match /moon_rewards/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list, update, delete: if isAdmin();
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'months', 'expires', 'status', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.status == 'unused'
        && request.resource.data.createdAt == request.time
        && moonRewardOk(request.resource.data)
        && moonStreakOk(uid));
    }

    // Báo đã thanh toán Companions: người dùng chỉ ghi được yêu cầu "pending" của chính mình; admin xem và duyệt/từ chối
    match /companion_requests/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Chỉ nhận đúng các ô web gửi; email phải là email thật của tài khoản đang đăng nhập (admin đối chiếu đúng người);
      // số tháng chỉ 1/3/12. Các số tháng tặng/số tiền khách gửi chỉ để admin xem: lúc Duyệt admin tự tính lại, không tin số này.
      allow create, update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'method', 'months', 'note', 'message', 'status', 'bonus', 'amount', 'reward', 'createdAt'])
            && request.resource.data.uid == uid
            && request.resource.data.status == 'pending'
            && request.resource.data.get('email', '') == request.auth.token.get('email', '')
            && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 100
            && request.resource.data.months in [1, 3, 12]
            && request.resource.data.method is string && request.resource.data.method.size() <= 20
            && request.resource.data.note is string && request.resource.data.note.size() <= 200
            && request.resource.data.get('message', '') is string && request.resource.data.get('message', '').size() <= 300
            && request.resource.data.get('bonus', 0) is number && request.resource.data.get('amount', 0) is number && request.resource.data.get('reward', 0) is number
            && request.resource.data.createdAt == request.time);
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // Planner tuần riêng tư của Companions: chỉ chính chủ đọc/ghi, và chỉ khi là Companion còn hạn hoặc đang dùng thử bằng mã (admin dùng thử được). Admin không đọc được của người khác.
    match /users/{uid}/planner/{wk} {
      allow read, write: if signedIn() && request.auth.uid == uid
        && (isAdmin() || (exists(/databases/$(database)/documents/companions/$(request.auth.uid)) && compActive(request.auth.uid))
            || trialOk(request.auth.uid));
    }

    // Mã dùng thử: khách KHÔNG liệt kê và KHÔNG đọc được mã nào (kể cả đoán tên mã); chỉ admin tạo/sửa/xoá.
    // Ngoại lệ: người đã kích hoạt một mã đọc được đúng mã đó (để biết số ngày dùng thử còn lại).
    // Người dùng chỉ được tăng `uses` thêm đúng 1, và chỉ trong cùng lần ghi tạo trial_redemptions/<uid> của chính họ cho mã này.
    match /trial_codes/{code} {
      allow get: if isAdmin()
        || (signedIn() && exists(/databases/$(database)/documents/trial_redemptions/$(request.auth.uid))
            && get(/databases/$(database)/documents/trial_redemptions/$(request.auth.uid)).data.code == code);
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses'])
            && request.resource.data.uses == resource.data.get('uses', 0) + 1
            && !exists(/databases/$(database)/documents/trial_redemptions/$(request.auth.uid))
            && getAfter(/databases/$(database)/documents/trial_redemptions/$(request.auth.uid)).data.code == code);
    }
    // Lượt kích hoạt: mỗi tài khoản MỘT lần (id = uid; người dùng không sửa/xoá được nên không tự gia hạn hay dùng lại).
    // startedAt phải là giờ máy chủ. Admin xem, đặt hạn riêng (endsAt), hoặc xoá để cho phép tài khoản đó dùng thử lại.
    match /trial_redemptions/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list, update, delete: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'code', 'startedAt', 'email'])
        && request.resource.data.uid == uid
        && request.resource.data.startedAt == request.time
        && request.resource.data.get('email', '') == request.auth.token.get('email', '')
        && request.resource.data.code is string
        && request.resource.data.code.matches('^[A-Z0-9-]{4,32}$')
        && trialRedeemOk(request.resource.data.code);
    }

    // Thông báo đẩy khi live: mỗi máy của khách lưu đúng 1 tài liệu, id = sha256(token) viết thường.
    // Không ai đọc hay liệt kê được token (kể cả admin): chỉ máy gửi (GitHub Actions, dùng tài khoản dịch vụ, không qua rules) mới đọc.
    // Khách chỉ ghi được token của chính mình: id phải khớp với hash của token, nên không ghi đè được tài liệu của máy khác.
    // Xoá: cần biết id, mà id chỉ suy ra được từ token của chính máy đó.
    match /push_tokens/{id} {
      allow read: if false;
      allow create, update: if id.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['token', 'lang', 'tz', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() >= 20 && request.resource.data.token.size() <= 1024
        && hashing.sha256(request.resource.data.token).toHexString().lower() == id
        && request.resource.data.lang is string && request.resource.data.lang.size() <= 8
        && request.resource.data.tz is string && request.resource.data.tz.size() <= 64
        && request.resource.data.updatedAt == request.time;
      allow delete: if id.matches('^[0-9a-f]{64}$');
    }
    // Nút "Gửi thông báo live ngay" (admin ghi push_admin/now) và trạng thái lần gửi gần nhất (máy gửi ghi push_admin/status, push_admin/state).
    match /push_admin/{id} { allow read, write: if isAdmin(); }

    // Tự báo live theo OBS: bảng lịch / bộ đếm trong OBS (overlay.html, không đăng nhập) ghi obs_signal/start lúc bạn bấm Start Streaming, kèm khoá bí mật k
    // (tạo ở Admin → Tổng quan → "Khoá OBS", lưu ở private/obs mà ai cũng KHÔNG đọc được, chỉ admin). Không đúng khoá thì không ghi được; chỉ admin đọc.
    // Admin (đang mở web) thấy tín hiệu này rồi tự ghi settings/onair để web báo "Đang live" đúng giờ OBS bắt đầu.
    match /private/{id} { allow read, write: if isAdmin(); }
    match /obs_signal/{id} {
      allow read: if isAdmin();
      allow create, update: if request.resource.data.keys().hasOnly(['start', 'sched', 'at', 'k'])
        && request.resource.data.start is number && request.resource.data.sched is number && request.resource.data.at is number
        && request.resource.data.k is string && request.resource.data.k.size() >= 16
        && request.resource.data.start <= request.time.toMillis() + 120000 && request.resource.data.start > request.time.toMillis() - 21600000
        && exists(/databases/$(database)/documents/private/obs)
        && request.resource.data.k == get(/databases/$(database)/documents/private/obs).data.k;
      allow delete: if false;
    }

    // Email nhắc lịch (trước đây là Challenge 30 ngày): id = email → tạo lần 2 bị từ chối (chống trùng)
    match /challenge_signups/{id} {
      allow create: if request.resource.data.keys().hasOnly(['codename', 'email', 'timestamp'])
                    && request.resource.data.email is string && request.resource.data.email.size() < 200
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
                    && request.resource.data.get('codename', '') is string && request.resource.data.get('codename', '').size() <= 60
                    && request.resource.data.timestamp == request.time
                    && id == request.resource.data.email;
      allow read, update, delete: if isAdmin();
    }
  }
}
