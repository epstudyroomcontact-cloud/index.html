rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = đúng email của chủ trang VÀ email đã được xác minh (không thể mạo danh vì phải mở được hộp thư).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'epstudyroom.contact@gmail.com';
    }
    function signedIn() { return request.auth != null; }
    // Người đồng hành còn hạn: có tài liệu companions/<uid> và (không có ngày hết hạn HOẶC ngày hết hạn YYYY-MM-DD chưa qua; so theo giờ UTC, có ân hạn 1 ngày)
    function compActive(uid) {
      let c = get(/databases/$(database)/documents/companions/$(uid)).data;
      let u = c.get('until', '');
      let d = request.time - duration.value(1, 'd');   // ân hạn 1 ngày: người dùng ở múi giờ phía tây UTC vẫn thấy "còn hạn" trên máy mình đến hết ngày của họ
      return u == null || u == ''
        || (int(u.split('-')[0]) * 10000 + int(u.split('-')[1]) * 100 + int(u.split('-')[2])
            >= d.year() * 10000 + d.month() * 100 + d.day());
    }
    // Cài đặt ưu đãi (admin chỉnh ở tab Thanh toán): bật/tắt, số tháng tặng thêm, số ngày hiệu lực. Mặc định bật, 1 tháng, 30 ngày.
    function moonCfg() { return get(/databases/$(database)/documents/settings/payments).data; }
    function moonRewardOk(d) {
      let c = moonCfg();
      return c.get('moonRewardOn', true) == true
        && d.months == c.get('moonRewardMonths', 1)
        && d.expires is timestamp
        && d.expires > request.time
        && d.expires <= request.time + duration.value(int(c.get('moonRewardDays', 30)) + 1, 'd');
    }
    // Mã dùng thử: khách đã đăng nhập nhập mã → được dùng như Người đồng hành (Planner, Focus không giới hạn) trong số ngày admin đặt cho mã.
    // Quyền dùng thử còn khi: admin đặt hạn riêng (endsAt) còn tương lai, HOẶC mã vẫn tồn tại, đang bật và chưa hết `days` ngày tính từ lúc kích hoạt (startedAt, giờ máy chủ).
    function trialOk(uid) {
      let p = /databases/$(database)/documents/trial_redemptions/$(uid);
      return exists(p) && trialLive(get(p).data);
    }
    function trialLive(r) {
      return r.get('endsAt', null) is timestamp ? r.endsAt > request.time : trialCodeLive(r.code, r.startedAt);
    }
    function trialCodeLive(code, started) {
      let p = /databases/$(database)/documents/trial_codes/$(code);
      return exists(p) && get(p).data.active == true && started + duration.value(get(p).data.days, 'd') > request.time;
    }
    // Kích hoạt mã: mã có thật, đang bật, chưa quá hạn nhập (expiresAt), và lượt dùng của mã được cộng đúng 1 trong cùng lần ghi, không vượt maxUses (0 = không giới hạn).
    function trialRedeemOk(code) {
      let c = get(/databases/$(database)/documents/trial_codes/$(code)).data;
      let n = getAfter(/databases/$(database)/documents/trial_codes/$(code)).data.get('uses', 0);
      return c.active == true
        && (c.get('expiresAt', null) == null || c.expiresAt > request.time)
        && n == c.get('uses', 0) + 1
        && (c.get('maxUses', 0) == 0 || n <= c.maxUses);
    }
    function moonStreakOk(uid) {
      let m = get(/databases/$(database)/documents/users/$(uid)).data.moon;
      return m.get('best', 0) >= 60 || m.days.size() >= 60;
    }
    // Giao diện, nội dung chữ/ảnh, thông tin thanh toán hiển thị cho khách, lịch live: ai cũng xem, chỉ admin sửa
    match /settings/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /weekly_schedules/{id} { allow read: if true; allow write: if isAdmin(); }

    // Bài viết: khách chỉ đọc được bài đã xuất bản
    match /posts/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // Sản phẩm đang hiển thị
    match /products/{id} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // File/link tải của sản phẩm số: chỉ admin, hoặc người đã được cấp quyền trong thư viện của họ
    match /products_private/{id} {
      allow read: if isAdmin()
        || (signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/library/$(id)));
      allow write: if isAdmin();
    }

    // Đơn hàng: khách (kể cả chưa đăng nhập) chỉ được TẠO đơn trạng thái pending; chỉ admin sửa
    match /orders/{id} {
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.code is string && request.resource.data.code.size() < 20
                    && request.resource.data.buyer.email is string
                    && (request.resource.data.uid == null
                        || (signedIn() && request.resource.data.uid == request.auth.uid));
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Mã giảm giá: khách chỉ kiểm tra được từng mã (get), không liệt kê được toàn bộ
    match /coupons/{code} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // Đánh giá: khách đã đăng nhập gửi (chờ duyệt); chỉ hiện công khai khi admin duyệt
    match /reviews/{id} {
      allow read: if resource.data.approved == true || isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.approved == false
                    && request.resource.data.text is string && request.resource.data.text.size() <= 600
                    && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    // Hồ sơ người dùng (việc cần làm, thống kê tập trung) — chỉ chính họ và admin
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid;
      match /library/{pid} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow write: if isAdmin();                            // admin cấp quyền tải khi xác nhận đã thanh toán
      }
    }

    // Người đồng hành (ủng hộ hằng tháng): chỉ admin ghi; người dùng chỉ đọc được tài liệu của chính mình
    match /companions/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Ưu đãi mốc 60 ngày của Hành trình trăng: mỗi tài khoản chỉ tạo được MỘT lần (tài liệu mang id = uid, người dùng không sửa/xoá được nên không dùng lại).
    // Rules kiểm: đúng số tháng tặng và hạn theo cài đặt của admin (settings/payments), ưu đãi đang bật, và hồ sơ của chính họ đã ghi chuỗi >= 60 ngày.
    // Chuỗi do trình duyệt tự ghi nên không thể chống giả mạo tuyệt đối, vì vậy admin vẫn đối chiếu khoản thanh toán thật khi duyệt (ưu đãi chỉ là tháng tặng thêm và do admin cộng khi duyệt, không tự mở quyền).
    match /moon_rewards/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list, update, delete: if isAdmin();
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'months', 'expires', 'status', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.status == 'unused'
        && request.resource.data.createdAt == request.time
        && moonRewardOk(request.resource.data)
        && moonStreakOk(uid));
    }

    // Báo đã thanh toán Companions: người dùng chỉ ghi được yêu cầu "pending" của chính mình; admin xem và duyệt/từ chối
    match /companion_requests/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.uid == uid
            && request.resource.data.status == 'pending'
            && request.resource.data.method is string && request.resource.data.method.size() <= 20
            && request.resource.data.note is string && request.resource.data.note.size() <= 200);
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // Planner tuần riêng tư của Companions: chỉ chính chủ đọc/ghi, và chỉ khi là Companion còn hạn hoặc đang dùng thử bằng mã (admin dùng thử được). Admin không đọc được của người khác.
    match /users/{uid}/planner/{wk} {
      allow read, write: if signedIn() && request.auth.uid == uid
        && (isAdmin() || (exists(/databases/$(database)/documents/companions/$(request.auth.uid)) && compActive(request.auth.uid))
            || trialOk(request.auth.uid));
    }

    // Mã dùng thử: khách KHÔNG liệt kê và KHÔNG đọc được mã nào (kể cả đoán tên mã); chỉ admin tạo/sửa/xoá.
    // Ngoại lệ: người đã kích hoạt một mã đọc được đúng mã đó (để biết số ngày dùng thử còn lại).
    // Người dùng chỉ được tăng `uses` thêm đúng 1, và chỉ trong cùng lần ghi tạo trial_redemptions/<uid> của chính họ cho mã này.
    match /trial_codes/{code} {
      allow get: if isAdmin()
        || (signedIn() && exists(/databases/$(database)/documents/trial_redemptions/$(request.auth.uid))
            && get(/databases/$(database)/documents/trial_redemptions/$(request.auth.uid)).data.code == code);
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses'])
            && request.resource.data.uses == resource.data.get('uses', 0) + 1
            && !exists(/databases/$(database)/documents/trial_redemptions/$(request.auth.uid))
            && getAfter(/databases/$(database)/documents/trial_redemptions/$(request.auth.uid)).data.code == code);
    }
    // Lượt kích hoạt: mỗi tài khoản MỘT lần (id = uid; người dùng không sửa/xoá được nên không tự gia hạn hay dùng lại).
    // startedAt phải là giờ máy chủ. Admin xem, đặt hạn riêng (endsAt), hoặc xoá để cho phép tài khoản đó dùng thử lại.
    match /trial_redemptions/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list, update, delete: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'code', 'startedAt', 'email'])
        && request.resource.data.uid == uid
        && request.resource.data.startedAt == request.time
        && request.resource.data.get('email', '') == request.auth.token.get('email', '')
        && request.resource.data.code is string
        && request.resource.data.code.matches('^[A-Z0-9-]{4,32}$')
        && trialRedeemOk(request.resource.data.code);
    }

    // Email nhắc lịch (trước đây là Challenge 30 ngày): id = email → tạo lần 2 bị từ chối (chống trùng)
    match /challenge_signups/{id} {
      allow create: if request.resource.data.email is string && request.resource.data.email.size() < 200
                    && id == request.resource.data.email;
      allow read, update, delete: if isAdmin();
    }
  }
}
